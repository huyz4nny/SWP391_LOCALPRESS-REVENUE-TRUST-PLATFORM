@startuml swimlane_sv4_05_refund_vi
title SV4-05 Hoàn tiền 4 mắt và Điều chỉnh quyền (UC055, UC056)

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Kế toán|
|Kế toán trưởng|
|Hệ thống LocalPress|
|Module SV1 / SV3|

|Khách hàng|
start
:Yêu cầu hoàn tiền qua hỗ trợ
(ngoài hệ thống);
|Kế toán|
:Mắt 1: chi tiết đơn (PAID) -> "Lập đề xuất hoàn"
hoặc trang Hoàn tiền: chọn đơn, số tiền, lý do;
|Hệ thống LocalPress|
switch (Kiểm tra đề xuất (UC055)?)
case (chưa SUCCESS /\nTOPUP / REFUND)
  :400 từ chối;
case (số tiền > hạn mức còn lại)
  :400 Refund Cap (Rule 11);
case (hợp lệ)
  :Tạo yêu cầu hoàn PENDING
(tính vào hạn mức);
  note right
  hạn mức còn lại = số tiền đã thu
- (PENDING + APPROVED + COMPLETED)
  end note
  |Kế toán trưởng|
  :Mắt 2: mở yêu cầu,
duyệt hoặc từ chối;
  |Hệ thống LocalPress|
  switch (Kết quả duyệt?)
  case (người duyệt = người lập)
    :403 nguyên tắc 4 mắt,
yêu cầu vẫn PENDING;
  case (đã xử lý trước đó)
    :409, không đổi gì;
  case (từ chối)
    :REJECTED, trả lại hạn mức,
khách giữ quyền lợi;
  case (duyệt)
    :COMPLETED, tạo giao dịch
REFUND (bút toán đảo);
    if (Đơn trả bằng ví?) then (có)
      :Cộng tiền hoàn
lại vào ví khách;
    else (không (QR SePay))
      :Chuyển trả tiền cho
khách ngoài hệ thống;
    endif
    if (Tổng đã hoàn
>= số tiền đã thu?) then (có)
      :Đơn gốc chuyển REFUNDED;
    else (không)
      :Đơn gốc giữ SUCCESS
(hoàn một phần);
    endif
  endswitch
endswitch
|Hệ thống LocalPress|
if (Hoàn tiền COMPLETED?) then (có)
  :Phát RefundCompletedEvent
(loại đơn, targetId, fullRefund);
  note right
  Rule 17: SV4 không sửa
bảng của SV1 / SV3
  end note
  |Module SV1 / SV3|
  :@EventListener (UC056): hoàn toàn bộ -> SV3 thu hồi
bài / gói, SV1 dừng quảng cáo; hoàn một phần -> giữ quyền;
  note right
  Chưa có trong code:
SV1 / SV3 phải tự viết
  end note
else (không)
  |Hệ thống LocalPress|
  :Không phát sự kiện,
quyền giữ nguyên;
endif
|Khách hàng|
:Nhận kết quả hoàn tiền;
stop

@enduml
