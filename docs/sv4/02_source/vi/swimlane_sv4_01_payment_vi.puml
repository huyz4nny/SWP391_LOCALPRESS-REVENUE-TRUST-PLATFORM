@startuml swimlane_sv4_01_payment_vi
title SV4-01 Trang thanh toán chung /payment/:orderCode, luôn qua ví (UC047 - UC050)

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Trang thanh toán|
|Hệ thống LocalPress|
|SePay / Ngân hàng|
|Module SV1 / SV3|

|Khách hàng|
start
:Bấm Mua ở module nguồn
(bài / gói / booking);
|Module SV1 / SV3|
:Tạo bản ghi chờ
(purchase / subscription / campaign);
|Hệ thống LocalPress|
:Tạo đơn PENDING (UC047)
mã LP..., hết hạn sau 15 phút;
note right
POST /api/v1/finance/orders
user lấy từ phiên đăng nhập,
không nhận X-User-Id
end note
|Trang thanh toán|
if (Đã đăng nhập?) then (rồi)
else (chưa)
  |Khách hàng|
  :Đăng nhập, quay lại trang này;
endif
|Hệ thống LocalPress|
:Tải đơn theo mã (UC050);
switch (Trạng thái đơn?)
case (không phải chủ đơn)
  :403 Forbidden (Rule 14);
case (đã SUCCESS)
  |Trang thanh toán|
  :Hiện kết quả "Đã thanh toán";
case (hết hạn / FAILED)
  |Trang thanh toán|
  :Hiện "Mã đã hết hạn": tạo đơn mới,
kiểm tra ví hoặc gửi khiếu nại;
case (PENDING còn hạn)
  |Trang thanh toán|
  :Hiện đơn, số dư ví,
số tiền và thời gian giữ đơn;
  note right
  Mọi đơn mua đều trả bằng
Ví LocalPress (từ 22/10/2026)
  end note
  |Hệ thống LocalPress|
  if (Số dư >= số tiền?) then (đủ)
    |Trang thanh toán|
    :Hiện 1 nút
"Thanh toán X bằng ví";
    |Khách hàng|
    :Bấm thanh toán;
    |Hệ thống LocalPress|
    :pay-with-wallet:
khóa đơn + ví,
kiểm tra lại chủ đơn,
hạn, số dư;
    if (Hợp lệ?) then (có)
      :Trừ ví, đơn SUCCESS
(phương thức WALLET);
    else (không)
      :402 / 403 / 410,
rollback, đơn
vẫn PENDING;
    endif
  else (thiếu)
    :shortfall-topup: tạo (hoặc dùng lại)
TOPUP = số tiền - số dư,
topup_for_order = mã đơn;
    |Trang thanh toán|
    :Hiện "Quét QR nạp bù X"
(nội dung = mã nạp);
    |Khách hàng|
    :Quét QR, chuyển khoản;
    |SePay / Ngân hàng|
    :Gửi webhook;
    |Hệ thống LocalPress|
    switch (Kết quả webhook (UC048, UC049)?)
    case (sai key /\nkhông có mã /\ngửi lại)
      :Không ghi nhận gì:
401 sai key,
ORDER_NOT_FOUND
(-> khiếu nại SV4-03),
ALREADY_PROCESSED;
    case (tiền nạp về)
      :Cộng ví đúng số tiền thực nhận
(ghi nhật ký sepay_id);
      if (Đơn còn chờ, còn hạn
và ví >= số tiền?) then (có)
        :Tự trừ ví,
đơn SUCCESS (autoPay PAID);
      else (không)
        :Tiền giữ trong ví:
INSUFFICIENT -> QR mới cho phần còn lại,
ORDER_EXPIRED -> tạo đơn mới;
      endif
    endswitch
    note right
    Chuyển thẳng vào mã đơn
(cách cũ / khiếu nại) vẫn được xử lý:
đủ -> SUCCESS, thiếu / muộn -> ví
    end note
  endif
  |Trang thanh toán|
  :Hỏi trạng thái mỗi 3 giây hoặc
"Tôi đã chuyển khoản, kiểm tra lại"
(hỏi API SePay, UC050);
  |Hệ thống LocalPress|
  if (Đơn SUCCESS?) then (có)
    :Phát PaymentSuccessEvent
(giao dịch = dòng sổ quỹ);
    |Module SV1 / SV3|
    :@EventListener: mở quyền đọc /
kích hoạt quảng cáo;
    note right
    Chưa có trong code:
SV1 / SV3 phải tự viết
    end note
  else (không)
    |Trang thanh toán|
    :Tiếp tục chờ đến khi trả đủ
hoặc đơn hết hạn;
  endif
endswitch
|Khách hàng|
:Xem kết quả thanh toán;
stop

@enduml
