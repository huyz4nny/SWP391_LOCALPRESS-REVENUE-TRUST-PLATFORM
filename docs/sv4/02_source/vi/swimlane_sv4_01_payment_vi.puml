@startuml swimlane_sv4_01_payment_vi
title SV4-01 Trang thanh toán chung /payment/:orderCode (UC047 - UC050)

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Trang thanh toán|
|Hệ thống LocalPress|
|SePay / Ngân hàng|
|Module SV1 / SV3|

|Khách hàng|
start
:Bấm Mua ở module nguồn
(bài / gói / booking);
|Module SV1 / SV3|
:Tạo bản ghi chờ
(purchase / subscription / campaign);
|Hệ thống LocalPress|
:Tạo đơn PENDING (UC047)
mã LP..., hết hạn sau 15 phút;
note right
POST /api/v1/finance/orders
user lấy từ phiên đăng nhập,
không nhận X-User-Id
end note
|Trang thanh toán|
if (Đã đăng nhập?) then (rồi)
else (chưa)
  |Khách hàng|
  :Đăng nhập, quay lại trang này;
endif
|Hệ thống LocalPress|
:Tải đơn theo mã (UC050);
switch (Trạng thái đơn?)
case (không phải chủ đơn)
  :403 Forbidden (Rule 14);
case (đã SUCCESS)
  |Trang thanh toán|
  :Hiện kết quả "Đã thanh toán";
case (hết hạn / FAILED)
  |Trang thanh toán|
  :Hiện "Mã đã hết hạn": tạo đơn mới,
kiểm tra ví hoặc gửi khiếu nại;
case (PENDING còn hạn)
  |Trang thanh toán|
  :Hiện đơn, số dư ví,
mã QR và đồng hồ đếm ngược;
  note right
  Đơn nạp ví: chỉ có QR,
không trả bằng ví (SV4-02)
  end note
  |Khách hàng|
  if (Thanh toán bằng?) then (Ví LocalPress)
    |Trang thanh toán|
    if (Số dư >= số tiền?) then (thiếu)
      :Hiện nút "Nạp thêm để thanh toán": khách
nạp phần thiếu (SV4-02) rồi quay lại;
    else (đủ)
      |Hệ thống LocalPress|
      :pay-with-wallet:
khóa đơn + ví,
kiểm tra lại chủ đơn,
hạn, số dư;
      if (Hợp lệ?) then (có)
        :Trừ ví, đơn SUCCESS
(phương thức WALLET);
      else (không)
        :402 / 403 / 410,
rollback, đơn
vẫn PENDING;
      endif
    endif
  else (QR SePay)
    |Khách hàng|
    :Chuyển khoản, nội dung = mã đơn;
    |SePay / Ngân hàng|
    :Gửi webhook IPN;
    |Hệ thống LocalPress|
    switch (Kết quả webhook (UC048, UC049)?)
    case (sai key /\nkhông thấy đơn /\nđã SUCCESS)
      :Không ghi nhận gì:
401 sai key,
ORDER_NOT_FOUND
(-> khiếu nại),
ALREADY_PROCESSED;
    case (booking hết\ngiữ chỗ /\nđơn đã đóng)
      :Đơn FAILED, tiền vào
ví "-LATE" (Rule 6);
    case (chuyển thiếu)
      :Tiền vào ví "-PART",
đơn vẫn PENDING;
    case (đủ / thừa)
      :Đơn SUCCESS, tiền thừa
vào ví "-EXCESS";
    endswitch
  endif
  |Trang thanh toán|
  :Hỏi trạng thái mỗi 3 giây hoặc
"Tôi đã chuyển khoản, kiểm tra lại" (UC050);
  |Hệ thống LocalPress|
  if (Đơn SUCCESS?) then (có)
    :Phát PaymentSuccessEvent
(giao dịch = dòng sổ quỹ);
    |Module SV1 / SV3|
    :@EventListener: mở quyền đọc /
kích hoạt quảng cáo;
    note right
    Chưa có trong code:
SV1 / SV3 phải tự viết
    end note
  else (không)
    |Trang thanh toán|
    :Tiếp tục chờ đến khi trả đủ
hoặc mã hết hạn;
  endif
endswitch
|Khách hàng|
:Xem kết quả thanh toán;
stop

@enduml
