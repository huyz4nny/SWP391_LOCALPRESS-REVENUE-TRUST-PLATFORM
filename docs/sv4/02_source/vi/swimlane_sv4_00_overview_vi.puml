@startuml swimlane_sv4_00_overview_vi
title SV4-00 Tổng quan: Thanh toán, Khiếu nại và Hoàn tiền\n<size:11>Bản tóm tắt - chi tiết từng nhánh xem SV4-01 .. SV4-06</size>

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Hệ thống LocalPress|
|SePay / Ngân hàng|
|Kế toán|
|Kế toán trưởng|

|Khách hàng|
start
:Chọn bài viết / gói / booking
hoặc bấm "Nạp tiền";
|Hệ thống LocalPress|
:Tạo đơn PENDING (UC047)
hết hạn sau 15 phút;
|Khách hàng|
:Mở trang thanh toán chung
/payment/:orderCode;
if (Thanh toán bằng?) then (Ví LocalPress)
  if (Ví đủ tiền?) then (đủ)
  else (không đủ)
    :Nạp thêm tiền vào ví
(QR SePay, xem SV4-02);
  endif
  |Hệ thống LocalPress|
  :Trừ ví, đơn SUCCESS;
else (QR SePay)
  |Khách hàng|
  :Quét QR, chuyển khoản;
  |SePay / Ngân hàng|
  :Gửi webhook IPN;
  |Hệ thống LocalPress|
  switch (Kết quả webhook\n(UC048, UC049)?)
  case (đủ / thừa)
    :Đơn SUCCESS
(tiền thừa vào ví);
  case (thiếu / về muộn)
    :Tiền vào ví,
đơn chưa hoàn tất;
  case (đơn nạp ví)
    :Cộng tiền vào ví;
  endswitch
endif
|Khách hàng|
if (Đã chuyển > 15 phút
mà chưa ghi nhận?) then (có)
  :Gửi khiếu nại (UC051);
  |Kế toán|
  :Đối chiếu sao kê (SV4-03);
  if (Thấy tiền
trên sao kê?) then (có)
    |Hệ thống LocalPress|
    :Ghi nhận vào đơn
hoặc cộng ví;
  else (không)
    |Kế toán|
    :Từ chối, ghi lý do;
  endif
else (không)
  |Khách hàng|
  :Thanh toán đã được ghi nhận;
endif
|Kế toán|
if (Khách yêu cầu hoàn
(qua hỗ trợ)?) then (không)
  |Khách hàng|
  :Giữ quyền lợi đã mua;
else (có)
  |Kế toán|
  :Mắt 1: lập đề xuất hoàn (UC055)
trong hạn mức (Rule 11);
  |Kế toán trưởng|
  if (Mắt 2
duyệt?) then (duyệt)
    |Hệ thống LocalPress|
    :Tạo giao dịch REFUND, phát
sự kiện: SV1 / SV3 thu hồi quyền;
  else (từ chối)
    |Kế toán trưởng|
    :REJECTED,
khách giữ quyền lợi;
  endif
endif
|Khách hàng|
:Nhận kết quả cuối cùng;
stop

@enduml
