@startuml swimlane_sv4_02_wallet_topup_vi
title SV4-02 Nạp tiền Ví LocalPress qua QR SePay\n<size:11>Tiền nạp là công nợ phải trả khách, không phải doanh thu (Rule 16)</size>

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Trang thanh toán|
|Hệ thống LocalPress|
|SePay / Ngân hàng|

|Khách hàng|
start
:Bấm "Nạp tiền" trên header
hoặc "Nạp thêm để thanh toán";
|Trang thanh toán|
if (Đã đăng nhập?) then (rồi)
else (chưa)
  |Khách hàng|
  :Đăng nhập, quay lại /wallet/topup;
endif
|Trang thanh toán|
:Chọn mức có sẵn (50k - 1tr)
hoặc tự nhập số tiền;
if (10.000 - 50.000.000 đ,
bội số 1.000?) then (không hợp lệ)
  |Trang thanh toán|
  :Báo lỗi nhập liệu;
else (hợp lệ)
  |Hệ thống LocalPress|
  :Kiểm tra lại hạn mức, tạo đơn
TOPUP PENDING (15 phút);
  note right
  Ngoài hạn mức hoặc số lẻ -> 400
  end note
  |Trang thanh toán|
  :Mở /payment/:orderCode
(chỉ có QR, không trả bằng ví);
  |Khách hàng|
  :Quét QR, chuyển khoản;
  |SePay / Ngân hàng|
  :Gửi webhook IPN;
  |Hệ thống LocalPress|
  switch (Kết quả webhook?)
  case (sai API key)
    :401, ví không đổi;
  case (đã SUCCESS)
    :ALREADY_PROCESSED
không cộng lần 2 (Rule 5);
  case (lần đầu)
    :TOPUP SUCCESS, cộng đúng số tiền
thực nhận (kể cả sau hạn QR),
ghi wallet_entries CREDIT;
    note right
    UNIQUE(transaction_id, direction)
    chặn cộng 2 lần
    end note
  endswitch
  |Trang thanh toán|
  if (Polling: đơn SUCCESS?) then (có)
    :Hiện số dư mới, quay lại /wallet
hoặc đơn đang thanh toán;
  else (không)
    :Tiếp tục chờ; quá 15 phút
hiện "Tạo mã nạp mới";
  endif
endif
|Khách hàng|
:Xem số dư và lịch sử ví;
stop

@enduml
