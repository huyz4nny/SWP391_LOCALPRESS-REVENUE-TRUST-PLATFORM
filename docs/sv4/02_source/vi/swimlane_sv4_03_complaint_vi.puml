@startuml swimlane_sv4_03_complaint_vi
title SV4-03 Khiếu nại thanh toán chưa ghi nhận (UC051)\n<size:11>Thay cho duyệt chuyển khoản thủ công - không có nút "đánh dấu đã thanh toán"</size>

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Khách hàng|
|Hệ thống LocalPress|
|Kế toán|
|Sao kê ngân hàng|

|Khách hàng|
start
:Mở /wallet/complaints
(hoặc link trên trang thanh toán);
:Nhập mã đơn (không bắt buộc), số tiền,
thời gian chuyển, mã GD ngân hàng;
|Hệ thống LocalPress|
switch (Kiểm tra khiếu nại?)
case (thiếu / sai dữ liệu)
  :400 lỗi nhập liệu;
case (mã GD đã khiếu nại)
  :409 trùng khiếu nại;
case (không thấy đơn /\nkhông phải đơn của mình)
  :404 / 403;
case (hợp lệ)
  :Lưu khiếu nại OPEN,
cảnh báo COMPLAINT_OPEN (UC060);
  |Kế toán|
  :Mở hàng chờ khiếu nại
(chỉ kế toán, người khác 403);
  note right
  Khiếu nại không còn OPEN -> 409
  end note
  |Sao kê ngân hàng|
  :Sao kê ngân hàng;
  |Kế toán|
  :Đối chiếu mã GD + số tiền,
chọn thao tác;
  |Hệ thống LocalPress|
  switch (Kế toán chọn?)
  case (ghi nhận vào đơn)
    switch (Chạy logic webhook (UC049)?)
    case (không có mã đơn)
      :400: hãy chọn cộng ví,
khiếu nại vẫn OPEN;
    case (đơn đã SUCCESS)
      :409: hãy chọn cộng ví,
khiếu nại vẫn OPEN;
    case (đủ / thiếu / muộn)
      :RESOLVED: đơn SUCCESS
hoặc tiền vào ví;
    endswitch
  case (cộng vào ví)
    if (Đơn còn PENDING
và còn hạn?) then (có)
      :409: phải ghi nhận vào đơn
(tránh ghi 2 lần);
    else (không)
      :RESOLVED: cộng ví,
mã CMP-mãGD, chỉ 1 lần;
    endif
  case (từ chối)
    if (Có nhập lý do?) then (có)
      :REJECTED kèm lý do;
    else (không)
      :400: bắt buộc nhập lý do;
    endif
  endswitch
endswitch
|Khách hàng|
:Xem trạng thái khiếu nại
tại /wallet/complaints;
stop

@enduml
