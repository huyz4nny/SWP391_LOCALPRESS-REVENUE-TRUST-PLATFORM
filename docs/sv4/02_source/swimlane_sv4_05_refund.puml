@startuml swimlane_sv4_05_refund
title SV4-05 Four-Eyes Refund and Rights Adjustment (UC055, UC056)

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Customer|
|Accountant|
|Chief Accountant|
|LocalPress Backend|
|SV1 / SV3 Modules|

|Customer|
start
:Ask for a refund via support
(outside the system);
|Accountant|
:1st eye: order detail (PAID) -> "Propose refund"
or Refund page: pick order, amount, reason;
|LocalPress Backend|
switch (Check proposal (UC055)?)
case (not SUCCESS /\nTOPUP / REFUND)
  :400 rejected;
case (amount > remaining cap)
  :400 Refund Cap (Rule 11);
case (valid)
  :Create refund PENDING
(counts toward the cap);
  note right
  remaining cap = paid amount
- (PENDING + APPROVED + COMPLETED)
  end note
  |Chief Accountant|
  :2nd eye: open request,
approve or reject;
  |LocalPress Backend|
  switch (Review result?)
  case (reviewer = proposer)
    :403 Four-Eyes,
request stays PENDING;
  case (already reviewed)
    :409, nothing changes;
  case (rejected)
    :REJECTED, cap released,
customer keeps rights;
  case (approved)
    :COMPLETED, create REFUND
transaction (reversal entry);
    if (Paid with wallet?) then (yes)
      :Credit refund back
to customer wallet;
    else (no (SePay QR))
      :Money returned to
customer outside system;
    endif
    if (Total refunded
>= paid amount?) then (yes)
      :Original order REFUNDED;
    else (no)
      :Original stays SUCCESS
(partial refund);
    endif
  endswitch
endswitch
|LocalPress Backend|
if (Refund COMPLETED?) then (yes)
  :Publish RefundCompletedEvent
(type, targetId, fullRefund);
  note right
  Rule 17: SV4 does not update
SV1 / SV3 tables
  end note
  |SV1 / SV3 Modules|
  :@EventListener (UC056): full refund -> SV3 revokes
article / plan, SV1 suspends ad; partial -> keep rights;
  note right
  Not in code yet:
SV1 / SV3 must write it
  end note
else (no)
  |LocalPress Backend|
  :No event,
rights unchanged;
endif
|Customer|
:Receive refund result;
stop

@enduml
