@startuml swimlane_sv4_03_complaint
title SV4-03 Unrecorded Payment Complaint (UC051)\n<size:11>Replaces manual transfer approval - no manual "mark as PAID"</size>

scale max 4000 width
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #000000
skinparam conditionStyle InsideDiamond
skinparam roundCorner 0
skinparam swimlane {
  BorderColor #000000
  TitleBackgroundColor #66BBE2
  TitleFontStyle bold
}
skinparam activity {
  BackgroundColor white
  BorderColor #000000
  DiamondBackgroundColor #FFF8DC
  DiamondBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}

|Customer|
|LocalPress Backend|
|Accountant|
|Bank Statement|

|Customer|
start
:Open /wallet/complaints
(or link on the payment page);
:Enter order code (optional), amount,
transfer time, bank transaction id;
|LocalPress Backend|
switch (Check complaint?)
case (missing / invalid field)
  :400 validation error;
case (bank tx id used before)
  :409 duplicate;
case (order not found /\nnot own order)
  :404 / 403;
case (valid)
  :Save complaint OPEN,
alert COMPLAINT_OPEN (UC060);
  |Accountant|
  :Open complaint queue
(finance staff only, others 403);
  note right
  Complaint no longer OPEN -> 409
  end note
  |Bank Statement|
  :Bank statement;
  |Accountant|
  :Match bank tx id + amount,
pick an action;
  |LocalPress Backend|
  switch (Accountant action?)
  case (record to order)
    switch (Run webhook logic (UC049)?)
    case (no order code)
      :400: choose wallet instead,
complaint stays OPEN;
    case (order already SUCCESS)
      :409: choose wallet instead,
complaint stays OPEN;
    case (full / under / late)
      :RESOLVED: order SUCCESS
or money to wallet;
    endswitch
  case (credit wallet)
    if (Order still PENDING
and in time?) then (yes)
      :409: must record to order
(avoid double count);
    else (no)
      :RESOLVED: credit wallet,
code CMP-ref, only once;
    endif
  case (reject)
    if (Reason entered?) then (yes)
      :REJECTED with reason;
    else (no)
      :400: reason required;
    endif
  endswitch
endswitch
|Customer|
:See complaint status
at /wallet/complaints;
stop

@enduml
